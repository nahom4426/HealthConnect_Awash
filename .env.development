# Standard Insurance dev backend. Every service URL below derives from this one host,
# and vite.config.ts proxies /api here for anything still using a relative path.
VITE_BACKEND_HOST=http://localhost:8888
VITE_NOTIFICATION_HOST=http://localhost:8888

v_API_AUTH_URI=${VITE_BACKEND_HOST}/api/payer/auth
v_API_URI=${VITE_BACKEND_HOST}/api/payer
v_API_PROVIDER_URI=${VITE_BACKEND_HOST}/api/v1/healthConnect

# Life Insurance service (separate Spring Boot app). The app calls /api/life, which the
# dev server proxies here; set v_API_LIFE_URI to a full URL to bypass the proxy.
VITE_LIFE_API_HOST=http://192.168.100.251:8194

v_RECEIPT_URL=${VITE_BACKEND_HOST}/api/payer/auth
v_RECEIPT_URL_PROVIDER=${VITE_BACKEND_HOST}/api/payer/motor/allPremium

# Other environments used in the past:
# VITE_BACKEND_HOST=https://trainnyala.medcoanalytics.com   (Nyala training server)
# VITE_BACKEND_HOST=https://nyalahc.medcoanalytics.com
# VITE_BACKEND_HOST=http://192.168.100.209:8888
